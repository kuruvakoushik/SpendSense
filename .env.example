# Copy this file to .env and replace the secret key before running.
# PowerShell: Copy-Item .env.example .env

FLASK_APP=run.py
FLASK_DEBUG=1
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
DATABASE_PATH=instance/spendsense.db

# Set to 1 only when serving over HTTPS in production.
SESSION_COOKIE_SECURE=0
